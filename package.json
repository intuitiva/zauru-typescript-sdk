{
  "name": "zauru-sdk",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rm -rf dist",
    "components:play": "pnpm --filter @zauru-sdk/components play",
    "publish:packages": "lerna publish --registry https://registry.npmjs.org/ --no-verify-access",
    "publish:recursive": "pnpm -r publish --access public --no-git-checks --registry https://registry.npmjs.org/",
    "sync:workspace-protocol": "node scripts/sync-workspace-protocol.mjs",
    "version": "node scripts/sync-workspace-protocol.mjs"
  },
  "devDependencies": {
    "lerna": "^8.1.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.7.1+sha512.faf344af2d6ca65c4c5c8c2224ea77a81a5e8859cbc4e06b1511ddce2f0151512431dd19e6aff31f2c6a8f5f2aced9bd2273e1fed7dd4de1868984059d2c4247"
}
