{
  "name": "@zauru-sdk/utils",
  "version": "6.19.0",
  "description": "Utilidades, parseo de request y demás para desarrollo de webapps de Zauru",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./cloudwatch.server": {
      "types": "./dist/zauru/cloudwatch.server.d.ts",
      "import": "./dist/esm/zauru/cloudwatch.server.js",
      "default": "./dist/esm/zauru/cloudwatch.server.js"
    },
    "./remix-entry.server": {
      "types": "./dist/zauru/remix-entry.server.d.ts",
      "import": "./dist/esm/zauru/remix-entry.server.js",
      "default": "./dist/esm/zauru/remix-entry.server.js"
    }
  },
  "typesVersions": {
    "*": {
      "cloudwatch.server": [
        "./dist/zauru/cloudwatch.server.d.ts"
      ],
      "remix-entry.server": [
        "./dist/zauru/remix-entry.server.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run build:esm",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist"
  ],
  "author": "Oscar Cuéllar",
  "license": "MIT",
  "peerDependencies": {
    "@remix-run/react": "^1.13.0 || ^2.8.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@remix-run/react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remix-run/react": "^2.8.1",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1123.0",
    "@remix-run/node": "^2.8.1",
    "@zauru-sdk/common": "workspace:^",
    "@zauru-sdk/config": "workspace:^",
    "@zauru-sdk/graphql": "workspace:^",
    "@zauru-sdk/services": "workspace:^",
    "@zauru-sdk/types": "workspace:^",
    "moment": "^2.30.1"
  },
  "gitHead": "57c966c16b47b52c32e72d40ccd7c76d9aaba247"
}
